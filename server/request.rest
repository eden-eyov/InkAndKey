  "email": "maya@example.com",
  "password": "WRONG_PASSWORD"
}

### Refresh access token
### Expected: 200 when the refresh cookie is valid
POST {{baseUrl}}/auth/refresh-token

### Logout
### Expected: 200 and refresh cookie cleared
POST {{baseUrl}}/auth/logout

### Get current user
### Expected: 200
GET {{baseUrl}}/auth/me
Authorization: Bearer {{primaryToken}}

### Get current user without token
### Expected: 401
GET {{baseUrl}}/auth/me

### Get current user with invalid token
### Expected: 401
GET {{baseUrl}}/auth/me
Authorization: Bearer invalid-token

### Update current user
### Expected: 200
PATCH {{baseUrl}}/auth/me
Authorization: Bearer {{primaryToken}}
Content-Type: application/json

{
  "favoriteBooks": ["Fourth Wing"],
  "favoriteGenres": ["Fantasy", "Romance"]
}



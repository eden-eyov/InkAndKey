### ==================================================
### Ink & Key API - REST Client collection
### ==================================================

@baseUrl = http://localhost:5000/api

### --------------------------------------------------
### Local test credentials
### Keep placeholders only. Never commit real passwords or tokens.
### --------------------------------------------------
@testPassword = YOUR_TEST_PASSWORD

### --------------------------------------------------
### Access tokens
### --------------------------------------------------
@primaryToken = YOUR_PRIMARY_USER_ACCESS_TOKEN
@secondaryToken = YOUR_SECONDARY_USER_ACCESS_TOKEN
@pollCreatorToken = YOUR_POLL_CREATOR_ACCESS_TOKEN
@lowerProgressToken = YOUR_LOWER_PROGRESS_USER_ACCESS_TOKEN
@nonMemberToken = YOUR_NON_MEMBER_ACCESS_TOKEN

### --------------------------------------------------
### User IDs
### --------------------------------------------------
@primaryUserId = YOUR_PRIMARY_USER_ID
@secondaryUserId = YOUR_SECONDARY_USER_ID
@pollCreatorUserId = YOUR_POLL_CREATOR_USER_ID

### --------------------------------------------------
### Fantasy Readers test data
### --------------------------------------------------
@fantasyClubId = YOUR_FANTASY_CLUB_ID
@fantasyBookId = YOUR_FANTASY_BOOK_ID
@progressId = YOUR_PROGRESS_ID
@commentId = YOUR_COMMENT_ID
@parentCommentId = YOUR_PARENT_COMMENT_ID
@replyId = YOUR_REPLY_ID

### --------------------------------------------------
### Poll test data
### --------------------------------------------------
@pollClubId = YOUR_POLL_CLUB_ID
@pollId = YOUR_POLL_ID
@pollOptionId = YOUR_POLL_OPTION_ID

### --------------------------------------------------
### DNF and rating test data
### --------------------------------------------------
@dnfClubId = YOUR_DNF_CLUB_ID
@dnfBookId = YOUR_DNF_BOOK_ID
@dnfProgressId = YOUR_DNF_PROGRESS_ID
@completedProgressId = YOUR_COMPLETED_PROGRESS_ID
@readingProgressId = YOUR_READING_PROGRESS_ID

### --------------------------------------------------
### Club archive test data
### --------------------------------------------------
@archiveClubId = YOUR_ARCHIVE_TEST_CLUB_ID
@archiveClubCreatorToken = YOUR_ARCHIVE_CLUB_CREATOR_TOKEN
@archiveClubMemberToken = YOUR_ARCHIVE_CLUB_MEMBER_TOKEN

### --------------------------------------------------
### Current book removal test data
### --------------------------------------------------
@currentBookDeleteCreatorToken = YOUR_CLUB_CREATOR_ACCESS_TOKEN
@currentBookDeleteMemberToken = YOUR_CLUB_MEMBER_ACCESS_TOKEN
@currentBookDeleteClubId = YOUR_TEST_CLUB_ID
@currentBookDeleteBookId = YOUR_CURRENT_BOOK_ID
@currentBookDeletePollId = YOUR_RELATED_POLL_ID



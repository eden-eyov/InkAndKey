### ==================================================
### Ink & Key API - REST Client collection
### Fill these values locally before running protected requests.
### Do not commit real passwords, access tokens, or resource IDs.
### ==================================================

@baseUrl = http://localhost:5000/api

### Local test credentials
@testPassword = YOUR_TEST_PASSWORD

### Access tokens
@primaryToken = YOUR_PRIMARY_USER_ACCESS_TOKEN
@secondaryToken = YOUR_SECONDARY_USER_ACCESS_TOKEN
@pollCreatorToken = YOUR_POLL_CREATOR_ACCESS_TOKEN

### User IDs
@primaryUserId = YOUR_PRIMARY_USER_ID
@secondaryUserId = YOUR_SECONDARY_USER_ID
@pollCreatorUserId = YOUR_POLL_CREATOR_USER_ID

### Fantasy Readers test data
@fantasyClubId = YOUR_FANTASY_CLUB_ID
@fantasyBookId = YOUR_FANTASY_BOOK_ID
@progressId = YOUR_PROGRESS_ID
@commentId = YOUR_COMMENT_ID

### Poll test data
@pollClubId = YOUR_POLL_CLUB_ID
@pollId = YOUR_POLL_ID
@pollOptionId = YOUR_POLL_OPTION_ID

### DNF and rating test data
@dnfClubId = YOUR_DNF_CLUB_ID
@dnfBookId = YOUR_DNF_BOOK_ID
@dnfProgressId = YOUR_DNF_PROGRESS_ID



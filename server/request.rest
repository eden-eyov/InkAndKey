### ==================================================
### COMMENT, THREAD, AND REPLY TESTS
### ==================================================

### Create regular chapter comment
### Expected: 201
POST {{baseUrl}}/comments
Authorization: Bearer {{primaryToken}}
Content-Type: application/json

{
  "club": "{{fantasyClubId}}",
  "book": "{{fantasyBookId}}",
  "text": "I loved the way the story developed in this chapter.",
  "chapterNumber": 3,
  "isSpoilerFreeReview": false,
  "parentComment": null
}

### Create locked future chapter comment
### Expected: 201
POST {{baseUrl}}/comments
Authorization: Bearer {{primaryToken}}
Content-Type: application/json

{
  "club": "{{fantasyClubId}}",
  "book": "{{fantasyBookId}}",
  "text": "This comment talks about something important that happens much later.",
  "chapterNumber": 10,
  "isSpoilerFreeReview": false,
  "parentComment": null
}

### Create a crafted reply that tries to bypass spoiler protection
### Expected: 201, but the server must inherit the parent's protection.
POST {{baseUrl}}/comments
Authorization: Bearer {{primaryToken}}
Content-Type: application/json

{
  "club": "{{fantasyClubId}}",
  "book": "{{fantasyBookId}}",
  "text": "This reply contains information from the locked parent discussion.",
  "chapterNumber": 0,
  "isSpoilerFreeReview": true,
  "parentComment": "{{parentCommentId}}"
}

### Create spoiler-free public review
### Expected: 201
POST {{baseUrl}}/comments
Authorization: Bearer {{primaryToken}}
Content-Type: application/json

{
  "club": "{{fantasyClubId}}",
  "book": "{{fantasyBookId}}",
  "text": "A beautifully written fantasy book with a cozy and adventurous atmosphere.",
  "chapterNumber": 0,
  "isSpoilerFreeReview": true,
  "parentComment": null
}

### Get comments for logged-in user
### Expected: 200
GET {{baseUrl}}/comments?club={{fantasyClubId}}&book={{fantasyBookId}}
Authorization: Bearer {{primaryToken}}

### Read discussions as a lower-progress user
### Expected: protected parent and reply are locked; protected text is absent.
GET {{baseUrl}}/comments?club={{fantasyClubId}}&book={{fantasyBookId}}
Authorization: Bearer {{lowerProgressToken}}

### Try to read discussions as a non-member
### Expected: 403
GET {{baseUrl}}/comments?club={{fantasyClubId}}&book={{fantasyBookId}}
Authorization: Bearer {{nonMemberToken}}

### Get public spoiler-free comments
### Expected: 200; crafted reply under a protected parent must not leak.
GET {{baseUrl}}/comments/public?club={{fantasyClubId}}&book={{fantasyBookId}}

### Get a single comment
### Expected: 200
GET {{baseUrl}}/comments/{{commentId}}
Authorization: Bearer {{primaryToken}}

### Toggle like comment
### Expected: 200
POST {{baseUrl}}/comments/{{commentId}}/like
Authorization: Bearer {{primaryToken}}

### Update my comment
### Expected: 200
PATCH {{baseUrl}}/comments/{{commentId}}
Authorization: Bearer {{primaryToken}}
Content-Type: application/json

{
  "text": "Edited comment text.",
  "chapterNumber": 3,
  "isSpoilerFreeReview": false
}

### Try to update another user's comment
### Expected: 403
PATCH {{baseUrl}}/comments/{{commentId}}
Authorization: Bearer {{secondaryToken}}
Content-Type: application/json

{
  "text": "This unauthorized update should fail."
}

### Delete my comment
### Expected:
### - without replies, it may be removed completely
### - with replies, the parent content is replaced safely and replies remain
DELETE {{baseUrl}}/comments/{{commentId}}
Authorization: Bearer {{primaryToken}}

### Read discussions after deleting the parent comment
### Expected: replies remain accessible and the deleted parent is represented safely.
GET {{baseUrl}}/comments?club={{fantasyClubId}}&book={{fantasyBookId}}
Authorization: Bearer {{primaryToken}}


